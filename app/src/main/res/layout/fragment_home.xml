<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Cyber Header Bar with Dynamic Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_surface">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ GAMEPANEL AI [CYBER MOD HUD]"
            android:textColor="@color/accent_cyan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/tvSystemGauges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU: 14% | 60 FPS"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@color/bg_card"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Independent Master Power Switches Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="1dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MASTER POWER &amp; OVERLAY CONTROL"
                        android:textColor="@color/accent_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Crosshair Switch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎯 CROSSHAIR OVERLAY SIGHT"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchCrosshairMaster"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:useMaterialThemeColors="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/bg_card_stroke"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Floating Panel Switch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎛️ FLOATING QUICK PANEL BUBBLE"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchPanelMaster"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:useMaterialThemeColors="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Target Game Profile Selector Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/accent_green"
                app:strokeWidth="1dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET APPLICATION &amp; HUD PROFILE"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerGameSelector"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/bg_surface" />

                    <TextView
                        android:id="@+id/tvGameProfileInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE PROFILE: Free Fire Main"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Crosshair Preview & Pro Sight Presets Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/accent_cyan"
                app:strokeWidth="1dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REAL-TIME CROSSHAIR RADAR PREVIEW"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/bg_surface">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/bg_card_stroke" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_horizontal"
                            android:background="@color/bg_card_stroke" />

                        <com.gamepanel.ai.view.CrosshairView
                            android:id="@+id/homeCrosshairPreview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <!-- Pro Sight Presets Bar -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO SIGHT PRESETS (1-TAP QUICK APPLY)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnPresetDot"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:text="DOT"
                            android:textSize="9sp"
                            android:backgroundTint="@color/bg_surface"
                            android:textColor="@color/accent_cyan" />

                        <Button
                            android:id="@+id/btnPresetCircle"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:text="SNIPER"
                            android:textSize="9sp"
                            android:backgroundTint="@color/bg_surface"
                            android:textColor="@color/accent_green" />

                        <Button
                            android:id="@+id/btnPresetCross"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:text="TACTICAL"
                            android:textSize="9sp"
                            android:backgroundTint="@color/bg_surface"
                            android:textColor="@color/accent_yellow" />

                        <Button
                            android:id="@+id/btnPresetRing"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:text="SHOTGUN"
                            android:textSize="9sp"
                            android:backgroundTint="@color/bg_surface"
                            android:textColor="@color/accent_red" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CYBER UTILITY SUITE"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navGallery"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="GALLERY (200+)"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/navCustomizer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="CUSTOMIZER"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navPositionEditor"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="POSITION EDITOR"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/navProfiles"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="PROFILES"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navIntelligence"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="AI INTELLIGENCE"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/accent_cyan" />

                <Button
                    android:id="@+id/navCalibration"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="CALIBRATION"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navScreenRecorder"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="RECORDER (HIDDEN)"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/accent_green" />

                <Button
                    android:id="@+id/navPerformance"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="PERFORMANCE"
                    android:textSize="11sp"
                    android:backgroundTint="@color/bg_card"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <Button
                android:id="@+id/navSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:text="SYSTEM SETTINGS &amp; BACKUP"
                android:textSize="11sp"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/text_primary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
