<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_surface">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="POSITION VISUAL EDITOR"
            android:textColor="@color/accent_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="12dp" />

        <Button
            android:id="@+id/btnSavePosition"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="SAVE"
            android:textSize="11sp"
            android:backgroundTint="@color/accent_cyan"
            android:textColor="@color/bg_dark" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended reference position — fine-tune for your HUD and play style."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:id="@+id/phonePreviewArea"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/bg_card"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/bg_card_stroke" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/bg_card_stroke" />

                <com.gamepanel.ai.view.CrosshairView
                    android:id="@+id/posCrosshairView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPosCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X: 0, Y: 0"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horizontal Offset (X)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/sbPosX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="400"
                android:progress="200" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vertical Offset (Y)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/sbPosY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="400"
                android:progress="200" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnCenterPos"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="CENTER"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnResetPos"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="RESET"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
